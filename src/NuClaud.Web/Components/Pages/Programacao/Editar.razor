@page "/programacao/nova"
@page "/programacao/{Id:int}/editar"
@attribute [Authorize(Policy = "Administrador")]
@inherits PaginaBase
@inject ProgramacaoServico Programacao
@inject IRelogio Relogio

<PageTitle>@(Id == null ? "Nova auditoria" : $"Editar {_codigo}") — NUCLAUD</PageTitle>
<PageHeader Titulo="@(Id == null ? "Programar nova auditoria" : $"Editar programação {_codigo}")"
            Subtitulo="@(Id == null ? "O código será gerado automaticamente ao salvar." : "Os dados atuais estão preenchidos abaixo.")">
    <Migalhas><a href="/programacao">Programar auditorias</a> › @(Id == null ? "Nova" : _codigo)</Migalhas>
</PageHeader>

<NavigationLock ConfirmExternalNavigation="_sujo" OnBeforeInternalNavigation="ConfirmarSaida" />

<div class="conteudo">
    @if (ErroCarga != null)
    {
        <div class="alerta alerta-erro" role="alert">@ErroCarga</div>
    }
    else if (_dados == null)
    {
        <p class="carregando">Carregando…</p>
    }
    else
    {
        <ListaErros Erros="Erros" />
        @if (_bloqueio != null)
        {
            <div class="alerta alerta-aviso" role="note"><strong>Alterações limitadas.</strong> @_bloqueio</div>
        }
        else if (_temPlano || _temRelatorio)
        {
            <div class="alerta alerta-info" role="note">
                Esta auditoria já possui @(_temRelatorio ? "plano e relatório (em revisão)" : "plano salvo"). O plano herda os dados desta programação;
                as alterações ficam registradas no histórico.
                @if (_temRelatorio) { <span>Requisitos já classificados em constatações não podem ser retirados.</span> }
            </div>
        }

        <form @onsubmit="Salvar" @onsubmit:preventDefault="true" novalidate>
            <section class="cartao">
                <h2 class="secao-titulo">Identificação</h2>
                <div class="grade">
                    <div class="campo col-4">
                        <span class="rotulo obrigatorio" id="rot-tipo">Tipo</span>
                        <div class="opcoes-radio horizontal" role="radiogroup" aria-labelledby="rot-tipo">
                            <label class="marcador @(Id != null ? "desabilitado" : "")">
                                <input type="radio" name="tipo" checked="@(_m.Tipo == TipoAuditoria.Interna)" disabled="@(Id != null)" @onchange="() => TrocarTipo(TipoAuditoria.Interna)" />Interna
                            </label>
                            <label class="marcador @(Id != null ? "desabilitado" : "")">
                                <input type="radio" name="tipo" checked="@(_m.Tipo == TipoAuditoria.Fornecedor)" disabled="@(Id != null)" @onchange="() => TrocarTipo(TipoAuditoria.Fornecedor)" />Fornecedores
                            </label>
                        </div>
                        @if (Id != null) { <span class="ajuda">Tipo e ano definem o código e não podem ser alterados.</span> }
                    </div>
                    <div class="campo col-4">
                        <label for="ano" class="obrigatorio">Ano</label>
                        <input id="ano" type="number" min="2000" max="2100" value="@_m.Ano" disabled="@(Id != null)" @onchange="DefinirAno" />
                    </div>
                    <div class="campo col-4">
                        <label for="mes" class="obrigatorio">Mês previsto</label>
                        <select id="mes" value="@_m.MesPrevisto" @onchange="DefinirMes">
                            <option value="0">Selecione…</option>
                            @for (int i = 1; i <= 12; i++) { <option value="@i">@Rotulos.NomeMes(i)</option> }
                        </select>
                    </div>
                </div>
            </section>

            @if (_m.Tipo == TipoAuditoria.Fornecedor)
            {
                <section class="cartao">
                    <h2 class="secao-titulo">Fornecedor</h2>
                    <div class="grade">
                        <div class="campo col-8">
                            <label for="f-nome" class="obrigatorio">Nome do fornecedor</label>
                            <input id="f-nome" type="text" maxlength="200" value="@_m.FornecedorNome" disabled="@Travado" @onchange="e => { _m.FornecedorNome = e.Value?.ToString(); Mudou(); }" />
                        </div>
                        <div class="campo col-4">
                            <label for="f-cnpj" class="obrigatorio">CNPJ do fornecedor</label>
                            <input id="f-cnpj" type="text" inputmode="numeric" maxlength="18" placeholder="00.000.000/0000-00" value="@_m.FornecedorCnpj" disabled="@Travado"
                                   @onchange="e => { _m.FornecedorCnpj = Validacoes.FormatarCnpj(e.Value?.ToString()); Mudou(); }" />
                            @if (!string.IsNullOrWhiteSpace(_m.FornecedorCnpj) && !Validacoes.CnpjValido(_m.FornecedorCnpj))
                            {
                                <span class="msg-erro">CNPJ inválido (verifique os dígitos).</span>
                            }
                        </div>
                        <div class="campo col-12">
                            <label for="f-end" class="obrigatorio">Endereço do fornecedor</label>
                            <input id="f-end" type="text" maxlength="400" value="@_m.FornecedorEndereco" disabled="@Travado" @onchange="e => { _m.FornecedorEndereco = e.Value?.ToString(); Mudou(); }" />
                        </div>
                        <div class="campo col-12">
                            <label for="f-escopo" class="obrigatorio">Escopo de fornecimento</label>
                            <textarea id="f-escopo" maxlength="2000" rows="3" disabled="@Travado" @onchange="e => { _m.EscopoFornecimento = e.Value?.ToString(); Mudou(); }">@_m.EscopoFornecimento</textarea>
                        </div>
                    </div>
                </section>
            }

            <section class="cartao">
                <h2 class="secao-titulo">Normas@(_m.Tipo == TipoAuditoria.Interna ? ", áreas e processos" : "")</h2>
                <div class="grade">
                    <div class="campo col-12">
                        <span class="rotulo obrigatorio" id="rot-normas">Normas</span>
                        <SeletorMultiplo Id="normas" Rotulo="Normas" Placeholder="Selecione uma ou mais normas" Opcoes="OpcoesNormas" Selecionados="_m.NormaIds"
                                         SelecionadosChanged="TrocarNormas" Desabilitado="Travado" AriaDescricao="rot-normas" />
                    </div>
                    @if (_m.Tipo == TipoAuditoria.Interna)
                    {
                        <div class="campo col-12">
                            <span class="rotulo obrigatorio" id="rot-areas">Áreas</span>
                            <SeletorMultiplo Id="areas" Rotulo="Áreas" Placeholder="Selecione uma ou mais áreas" Opcoes="OpcoesAreas" Selecionados="_m.AreaIds"
                                             SelecionadosChanged="v => { _m.AreaIds = v; Mudou(); }" Desabilitado="Travado" AriaDescricao="rot-areas"
                                             SemOpcoes="Nenhuma área ativa. Cadastre em Administração › Cadastrar áreas." />
                        </div>
                        <div class="campo col-6">
                            <span class="rotulo" id="rot-macro">Macroprocessos</span>
                            <SeletorMultiplo Id="macros" Rotulo="Macroprocessos" Placeholder="Todos" Opcoes="OpcoesMacros" Selecionados="_filtroMacros"
                                             SelecionadosChanged="v => _filtroMacros = v" Desabilitado="Travado" AriaDescricao="rot-macro" />
                            <span class="ajuda">Opcional: filtra a lista de processos. Os macroprocessos dos processos escolhidos são registrados automaticamente.</span>
                        </div>
                        <div class="campo col-6">
                            <span class="rotulo" id="rot-proc">Processos</span>
                            <SeletorMultiplo Id="processos" Rotulo="Processos" Placeholder="Selecione (opcional)" Opcoes="OpcoesProcessos" Selecionados="_m.ProcessoIds"
                                             SelecionadosChanged="TrocarProcessos" Desabilitado="Travado" AriaDescricao="rot-proc" />
                            <span class="ajuda">Para cada processo você escolhe, abaixo, os requisitos que serão auditados.</span>
                        </div>
                    }
                </div>
            </section>

            <section class="cartao">
                <div class="cartao-cabecalho">
                    <h2 class="secao-titulo" style="margin:0;border:0">Requisitos a auditar</h2>
                    <span class="etiqueta etiqueta-info">@_m.Itens.Count requisito(s) selecionado(s)</span>
                </div>
                @if (_avisos.Count > 0)
                {
                    <div class="alerta alerta-info" role="status">
                        <strong>Requisitos atualizados:</strong>
                        <ul>@foreach (var a in _avisos) { <li>@a</li> }</ul>
                    </div>
                }
                @if (_m.NormaIds.Count == 0)
                {
                    <p class="texto-suave">Selecione as normas para escolher os requisitos.</p>
                }
                else
                {
                    @if (_m.Tipo == TipoAuditoria.Interna)
                    {
                        <p class="texto-suave pequeno">Para cada processo escolhido, marque os requisitos que serão auditados nele. Os marcados como “Relacionado ao processo” vêm do cadastro do processo e são apenas sugestão.
                            Use “Requisitos gerais” para requisitos auditados fora de um processo específico.</p>
                    }
                    <div class="campo" style="max-width:480px;margin-bottom:.8rem">
                        <label for="busca-req">Filtrar requisitos</label>
                        <input id="busca-req" type="search" placeholder="Número ou título" @bind="_buscaReq" @bind:event="oninput" />
                    </div>
                    @foreach (var g in Grupos())
                    {
                        var nSel = _m.Itens.Count(i => i.ProcessoId == g.ProcessoId);
                        <div class="grupo-norma">
                            <header>
                                <h4>@g.Titulo @if (g.Subtitulo != null) { <span class="texto-suave pequeno" style="font-weight:400">· @g.Subtitulo</span> }</h4>
                                <span class="linha-acoes">
                                    <span class="texto-suave pequeno">@nSel selecionado(s)</span>
                                    @if (g.Sugeridos.Count > 0 && !Travado)
                                    {
                                        <button type="button" class="btn btn-secundario btn-pequeno" @onclick="() => MarcarRelacionados(g)">Marcar relacionados (@g.Sugeridos.Count)</button>
                                    }
                                </span>
                            </header>
                            <details open="@(g.ProcessoId != null || nSel > 0 || _m.Tipo == TipoAuditoria.Fornecedor || _buscaReq.Length > 0)">
                                <summary style="padding:.6rem .9rem;cursor:pointer;font-weight:600">Mostrar / ocultar requisitos</summary>
                                <div class="lista-requisitos">
                                    @if (g.Normas.Count == 0)
                                    {
                                        <span class="texto-suave">Este processo não está cadastrado como auditável em nenhuma das normas selecionadas.</span>
                                    }
                                    @foreach (var n in g.Normas)
                                    {
                                        var reqs = RequisitosDaNorma(n.Id, g.ProcessoId).ToList();
                                        <div class="seletor-grupo">@n.Nome</div>
                                        @if (reqs.Count == 0)
                                        {
                                            <span class="texto-suave">Nenhum requisito ativo cadastrado para esta norma.</span>
                                        }
                                        @foreach (var r in reqs.Where(FiltroReq))
                                        {
                                            var item = new ItemRequisito(g.ProcessoId, r.Id);
                                            var marcado = _m.Itens.Contains(item);
                                            var usado = _emConstatacoes.Contains(item);
                                            var travado = Travado || (usado && marcado);
                                            <label class="marcador @(travado ? "desabilitado" : "")">
                                                <input type="checkbox" checked="@marcado" disabled="@travado" @onchange="() => AlternarItem(item)" />
                                                <span>
                                                    @r.Exibicao
                                                    @if (g.Sugeridos.Contains(r.Id)) { <span class="badge-obrigatorio" title="Requisito relacionado ao processo no cadastro">Relacionado ao processo</span> }
                                                    @if (!r.Ativo) { <span class="etiqueta etiqueta-inativo">Inativo</span> }
                                                    @if (usado) { <span class="detalhe">Classificado em constatação do relatório.</span> }
                                                </span>
                                            </label>
                                        }
                                    }
                                </div>
                            </details>
                        </div>
                    }
                }
            </section>

            <section class="cartao">
                <h2 class="secao-titulo">Equipe</h2>
                @if (_m.NormaIds.Count == 0)
                {
                    <p class="texto-suave">Selecione as normas para ver os auditores habilitados.</p>
                }
                <div class="grade">
                    <div class="campo col-4">
                        <span class="rotulo obrigatorio" id="rot-lider">Auditor líder</span>
                        <SeletorMultiplo Id="lider" Unico="true" Rotulo="Auditor líder" Placeholder="Selecione o auditor líder" Opcoes="Candidatos(FuncaoAuditoria.Lider)"
                                         Selecionados="LiderSet" SelecionadosChanged="TrocarLider" Desabilitado="@(Travado || _m.NormaIds.Count == 0)" AriaDescricao="rot-lider" />
                        <span class="ajuda">Habilitado como auditor líder em todas as normas selecionadas.</span>
                    </div>
                    <div class="campo col-4">
                        <span class="rotulo" id="rot-aud">Auditores</span>
                        <SeletorMultiplo Id="auditores" Rotulo="Auditores" Placeholder="Selecione os auditores" Opcoes="Candidatos(FuncaoAuditoria.Auditor)"
                                         Selecionados="_m.AuditorIds" SelecionadosChanged="v => { _m.AuditorIds = v; Mudou(); }" Desabilitado="@(Travado || _m.NormaIds.Count == 0)" AriaDescricao="rot-aud" />
                        <span class="ajuda">Habilitados como auditor em ao menos uma norma selecionada.</span>
                    </div>
                    <div class="campo col-4">
                        <span class="rotulo" id="rot-obs">Observadores</span>
                        <SeletorMultiplo Id="observadores" Rotulo="Observadores" Placeholder="Selecione (opcional)" Opcoes="Candidatos(FuncaoAuditoria.Observador)"
                                         Selecionados="_m.ObservadorIds" SelecionadosChanged="v => { _m.ObservadorIds = v; Mudou(); }" Desabilitado="@(Travado || _m.NormaIds.Count == 0)" AriaDescricao="rot-obs" />
                        <span class="ajuda">Habilitados como observador em ao menos uma norma selecionada.</span>
                    </div>
                </div>
                @if (_m.NormaIds.Count > 0)
                {
                    <h3 style="margin-top:1.2rem">Cobertura das normas pela equipe</h3>
                    <ul style="margin:0;padding-left:1.2rem">
                        @foreach (var n in NormasSelecionadas)
                        {
                            var cobrem = Equipe().Where(a => a.Habilitacoes.Any(h => h.NormaId == n.Id && (h.PodeAuditar || h.PodeLiderar))).Select(a => a.Nome).ToList();
                            <li>
                                <strong>@n.Nome:</strong>
                                @if (cobrem.Count > 0) { <span>✔ coberta por @string.Join(", ", cobrem)</span> }
                                else { <span class="msg-erro">✖ nenhum membro da equipe (líder ou auditores) habilitado como auditor nesta norma</span> }
                            </li>
                        }
                    </ul>
                    @foreach (var aviso in Incompatibilidades())
                    {
                        <div class="alerta alerta-aviso" style="margin-top:.8rem" role="status">@aviso</div>
                    }
                }

                <div class="barra-salvar">
                    <span class="estado @(_sujo ? "sujo" : "")">@(_sujo ? "Alterações não salvas" : "Sem alterações pendentes")</span>
                    <a class="btn btn-secundario" href="@(Id == null ? "/programacao" : $"/auditorias/{Id}")">Cancelar</a>
                    <button type="submit" class="btn btn-primario" disabled="@Ocupado"><Icone Nome="salvar" />@(Ocupado ? "Salvando…" : "Salvar programação")</button>
                </div>
            </section>
        </form>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "ano")] private int? AnoQuery { get; set; }

    private DadosFormularioProgramacao? _dados;
    private ProgramacaoEdicao _m = new();
    private string _codigo = "";
    private string? _bloqueio;
    private bool _temPlano, _temRelatorio, _sujo;
    private HashSet<ItemRequisito> _emConstatacoes = new();
    private HashSet<int> _filtroMacros = new();
    private readonly List<string> _avisos = new();
    private string _buscaReq = "";

    private bool Travado => _bloqueio != null;
    private HashSet<int> LiderSet => _m.LiderId is int l ? new() { l } : new();
    private IEnumerable<int> ProcessosEfetivos => _m.Tipo == TipoAuditoria.Interna ? _m.ProcessoIds : Enumerable.Empty<int>();
    private List<NormaInfo> NormasSelecionadas => _dados!.Normas.Where(n => _m.NormaIds.Contains(n.Id)).Select(n => new NormaInfo(n.Id, n.Nome)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await Carregar(async () =>
        {
            var ator = await ObterAtorAsync();
            _dados = await Programacao.ObterDadosFormularioAsync(ator, Id);
            if (Id is int id)
            {
                var s = await Programacao.ObterParaEdicaoAsync(ator, id);
                _m = s.Dados;
                _codigo = s.Codigo;
                _bloqueio = s.BloqueioEstrutura;
                _temPlano = s.TemPlano;
                _temRelatorio = s.TemRelatorio;
                _emConstatacoes = s.ItensEmConstatacoes;
            }
            else
            {
                _m.Ano = AnoQuery ?? FusoHorario.AnoAtual(Relogio) + 1;
            }
        });
    }

    private void Mudou() => _sujo = true;
    private void DefinirAno(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var a)) _m.Ano = a; Mudou(); }
    private void DefinirMes(ChangeEventArgs e) { _m.MesPrevisto = int.TryParse(e.Value?.ToString(), out var m) ? m : 0; Mudou(); }

    // ------------------------------------------------------------ Opções

    private List<OpcaoSelecao> OpcoesNormas => _dados!.Normas.Select(n => new OpcaoSelecao(n.Id, n.Nome, Detalhe: n.Ativo ? null : "Inativa — mantida apenas por já estar nesta auditoria")).ToList();
    private List<OpcaoSelecao> OpcoesAreas => _dados!.Areas.Select(a => new OpcaoSelecao(a.Id, a.Nome, Detalhe: a.Ativo ? null : "Inativa")).ToList();
    private List<OpcaoSelecao> OpcoesMacros => _dados!.Macroprocessos.Select(a => new OpcaoSelecao(a.Id, a.Nome, Detalhe: a.Ativo ? null : "Inativo")).ToList();

    private List<OpcaoSelecao> OpcoesProcessos
    {
        get
        {
            var macros = _dados!.Macroprocessos.ToDictionary(m => m.Id, m => m.Nome);
            return _dados.Processos
                .Where(p => _filtroMacros.Count == 0 || _filtroMacros.Contains(p.MacroprocessoId) || _m.ProcessoIds.Contains(p.Id))
                .OrderBy(p => macros.GetValueOrDefault(p.MacroprocessoId)).ThenBy(p => p.Nome)
                .Select(p =>
                {
                    var comuns = p.NormaIds.Intersect(_m.NormaIds).Count();
                    return new OpcaoSelecao(p.Id, p.Nome, macros.GetValueOrDefault(p.MacroprocessoId),
                        Detalhe: _m.NormaIds.Count > 0 && comuns == 0 ? "Não é auditável nas normas selecionadas" : null);
                }).ToList();
        }
    }

    private IEnumerable<RequisitoOpcao> RequisitosDaNorma(int normaId, int? processoId) =>
        _dados!.Requisitos.Where(r => r.NormaId == normaId && (r.Ativo || _m.Itens.Contains(new ItemRequisito(processoId, r.Id)))).OrderBy(r => r.Chave, StringComparer.Ordinal);

    private sealed record GrupoRequisitos(int? ProcessoId, string Titulo, string? Subtitulo, List<Norma> Normas, IReadOnlyList<int> Sugeridos);

    /// <summary>Um grupo por processo selecionado (normas em que o processo é auditável) e um grupo de requisitos gerais.</summary>
    private List<GrupoRequisitos> Grupos()
    {
        var normasSel = _dados!.Normas.Where(n => _m.NormaIds.Contains(n.Id)).ToList();
        var macros = _dados.Macroprocessos.ToDictionary(m => m.Id, m => m.Nome);
        var lista = new List<GrupoRequisitos>();
        foreach (var p in _dados.Processos.Where(p => ProcessosEfetivos.Contains(p.Id)).OrderBy(p => p.Nome))
            lista.Add(new GrupoRequisitos(p.Id, "Processo: " + p.Nome, macros.GetValueOrDefault(p.MacroprocessoId),
                normasSel.Where(n => p.NormaIds.Contains(n.Id)).ToList(), RegrasRequisitos.Sugeridos(p, _m.NormaIds)));
        lista.Add(new GrupoRequisitos(null, _m.Tipo == TipoAuditoria.Interna ? "Requisitos gerais (sem processo específico)" : "Requisitos",
            _m.Tipo == TipoAuditoria.Interna ? "opcional" : null, normasSel, Array.Empty<int>()));
        return lista;
    }

    private bool FiltroReq(RequisitoOpcao r)
    {
        var t = RegrasCalendario.SemAcento(_buscaReq.Trim());
        return t.Length == 0 || RegrasCalendario.SemAcento(r.Exibicao).Contains(t);
    }

    private IEnumerable<AuditorInfo> Equipe() =>
        _dados!.Auditores.Where(a => a.Id == _m.LiderId || _m.AuditorIds.Contains(a.Id));

    private List<OpcaoSelecao> Candidatos(FuncaoAuditoria funcao)
    {
        var normas = NormasSelecionadas;
        var lista = new List<OpcaoSelecao>();
        foreach (var a in _dados!.Auditores)
        {
            bool selecionado = funcao switch
            {
                FuncaoAuditoria.Lider => _m.LiderId == a.Id,
                FuncaoAuditoria.Auditor => _m.AuditorIds.Contains(a.Id),
                _ => _m.ObservadorIds.Contains(a.Id)
            };
            if (!a.Ativo && !selecionado) continue;
            string? motivo = null;
            if (funcao != FuncaoAuditoria.Lider && _m.LiderId == a.Id) motivo = "Já é o auditor líder desta auditoria.";
            else if (funcao == FuncaoAuditoria.Auditor && _m.ObservadorIds.Contains(a.Id)) motivo = "Já selecionado como observador.";
            else if (funcao == FuncaoAuditoria.Observador && _m.AuditorIds.Contains(a.Id)) motivo = "Já selecionado como auditor.";
            else
            {
                var c = RegrasHabilitacao.Verificar(a, funcao, normas);
                if (!c.Compativel) motivo = c.Motivo;
            }
            lista.Add(new OpcaoSelecao(a.Id, a.Nome, null, motivo != null, motivo));
        }
        return lista.OrderBy(o => o.Desabilitado).ThenBy(o => o.Texto).ToList();
    }

    private IEnumerable<string> Incompatibilidades()
    {
        var normas = NormasSelecionadas;
        var porId = _dados!.Auditores.ToDictionary(a => a.Id);
        if (_m.LiderId is int l && porId.TryGetValue(l, out var la) && RegrasHabilitacao.Verificar(la, FuncaoAuditoria.Lider, normas) is { Compativel: false } c1)
            yield return $"{la.Nome} (auditor líder): {c1.Motivo} Altere o líder ou as normas.";
        foreach (var id in _m.AuditorIds)
            if (porId.TryGetValue(id, out var a) && RegrasHabilitacao.Verificar(a, FuncaoAuditoria.Auditor, normas) is { Compativel: false } c2)
                yield return $"{a.Nome} (auditor): {c2.Motivo}";
        foreach (var id in _m.ObservadorIds)
            if (porId.TryGetValue(id, out var a) && RegrasHabilitacao.Verificar(a, FuncaoAuditoria.Observador, normas) is { Compativel: false } c3)
                yield return $"{a.Nome} (observador): {c3.Motivo}";
    }

    // ------------------------------------------------------------ Mudanças

    private void TrocarTipo(TipoAuditoria t)
    {
        if (_m.Tipo == t) return;
        _m.Tipo = t;
        Mudou();
        LimparItens(t == TipoAuditoria.Fornecedor
            ? "Auditoria de fornecedores não utiliza área, macroprocesso nem processo; esses campos não serão salvos."
            : null);
    }

    private void TrocarNormas(HashSet<int> v) { _m.NormaIds = v; Mudou(); LimparItens(null); }

    private void TrocarProcessos(HashSet<int> v)
    {
        _m.ProcessoIds = v;
        _m.MacroprocessoIds = _dados!.Processos.Where(p => v.Contains(p.Id)).Select(p => p.MacroprocessoId).ToHashSet();
        Mudou();
        LimparItens(null);
    }

    private void TrocarLider(HashSet<int> v)
    {
        _m.LiderId = v.Count == 0 ? null : v.First();
        if (_m.LiderId is int l)
        {
            if (_m.AuditorIds.Remove(l)) _avisos.Add("O auditor líder foi retirado da lista de auditores (uma pessoa por função).");
            if (_m.ObservadorIds.Remove(l)) _avisos.Add("O auditor líder foi retirado da lista de observadores (uma pessoa por função).");
        }
        Mudou();
    }

    private void AlternarItem(ItemRequisito item)
    {
        if (!_m.Itens.Remove(item)) _m.Itens.Add(item);
        Mudou();
    }

    private void MarcarRelacionados(GrupoRequisitos g)
    {
        foreach (var rid in g.Sugeridos) _m.Itens.Add(new ItemRequisito(g.ProcessoId, rid));
        Mudou();
    }

    /// <summary>Retira requisitos de processos ou normas que deixaram de estar selecionados e avisa.</summary>
    private void LimparItens(string? avisoExtra)
    {
        _avisos.Clear();
        if (avisoExtra != null) _avisos.Add(avisoExtra);
        var processos = _dados!.Processos.Where(p => ProcessosEfetivos.Contains(p.Id)).ToDictionary(p => p.Id);
        var porId = _dados.Requisitos.ToDictionary(r => r.Id);
        var retirar = _m.Itens.Where(i =>
        {
            if (!porId.TryGetValue(i.RequisitoId, out var r) || !_m.NormaIds.Contains(r.NormaId)) return true;
            if (i.ProcessoId is not int pid) return false;
            return !processos.TryGetValue(pid, out var p) || !p.NormaIds.Contains(r.NormaId);
        }).Where(i => !_emConstatacoes.Contains(i)).ToList();
        foreach (var i in retirar) _m.Itens.Remove(i);
        if (retirar.Count > 0)
            _avisos.Add($"{retirar.Count} requisito(s) retirado(s) por pertencerem a processos ou normas que não estão mais selecionados.");
    }

    // ------------------------------------------------------------ Salvar

    private async Task Salvar()
    {
        int novoId = 0;
        var ok = await Executar(async () => novoId = await Programacao.SalvarAsync(await ObterAtorAsync(), _m));
        if (ok)
        {
            _sujo = false;
            Notificacoes.Sucesso(Id == null ? "Auditoria programada com sucesso." : "Programação salva com sucesso.");
            Nav.NavigateTo($"/auditorias/{novoId}");
        }
    }

    private async Task ConfirmarSaida(LocationChangingContext ctx)
    {
        if (!_sujo) return;
        if (!await Confirmacao.ConfirmarAsync("Sair sem salvar?", "Há alterações não salvas nesta programação. Deseja sair e descartá-las?", "Sair sem salvar", true))
            ctx.PreventNavigation();
    }
}
