<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" href="@Assets["img/icone.svg"]" type="image/svg+xml" />
    <link rel="stylesheet" href="@Assets["css/nuclaud.css"]" />
    <link rel="stylesheet" href="@Assets["NuClaud.Web.styles.css"]" />
    <HeadOutlet @rendermode="ModoRenderizacao" />
</head>

<body>
    <Routes @rendermode="ModoRenderizacao" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Páginas de entrada/troca de senha usam renderização estática (formulários com cookie); o restante é interativo no servidor.
    private IComponentRenderMode? ModoRenderizacao =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
